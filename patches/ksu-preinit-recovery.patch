@@ -92,6 +92,27 @@
     kmsg_write(buf, n);
 }
 
+/*
+ * Same as klog() but at KERN_EMERG.  The console is gated to emergency only
+ * on this port, and pstore records just the console, so a failure that kills
+ * PID 1 has to be logged at this level to survive the panic.
+ */
+static __attribute__((format(printf, 1, 2))) void klog_emerg(const char *fmt, ...)
+{
+    char buf[LOG_LINE_MAX];
+    va_list args;
+    int n;
+
+    n = snprintf(buf, sizeof(buf), "<0>ksu_preinit: ");
+    va_start(args, fmt);
+    n += vsnprintf(buf + n, sizeof(buf) - n - 1, fmt, args);
+    va_end(args);
+    if (n > (int)sizeof(buf) - 2)
+        n = sizeof(buf) - 2;
+    buf[n++] = '\n';
+    kmsg_write(buf, n);
+}
+
