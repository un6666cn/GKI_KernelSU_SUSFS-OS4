@@ -84,6 +84,32 @@
  */
+extern char *saved_command_line;
+
+/*
+ * Recovery keeps /system in the ramdisk and redirects init's stdio to
+ * /dev/null, so the console ring buffer kept in pstore is the only record of
+ * a failure there.  Keep the console verbose unless the bootloader states
+ * that this is a normal boot.
+ */
+static bool meizu_console_verbose(void)
+{
+	static const char key[] = "force_normal_boot=1";
+	const char *p;
+	int i;
+
+	if (!saved_command_line)
+		return true;
+	for (p = saved_command_line; *p; p++) {
+		for (i = 0; key[i] && p[i] == key[i]; i++)
+			;
+		if (!key[i])
+			return false;
+	}
+	return true;
+}
+
 static int __init meizu_quiet_console_init(void)
 {
-	console_loglevel = CONSOLE_LOGLEVEL_MIN;
+	if (!meizu_console_verbose())
+		console_loglevel = CONSOLE_LOGLEVEL_MIN;
 	return 0;
 }
@@ -1225,3 +1251,3 @@
 	if (!ignore_loglevel && !oops_in_progress &&
-	    level >= CONSOLE_LOGLEVEL_MIN)
+	    level >= CONSOLE_LOGLEVEL_MIN && !meizu_console_verbose())
 		return true;
