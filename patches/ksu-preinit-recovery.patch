+/*
+ * Recovery keeps /system in the ramdisk, so /system/bin/recovery is the very
+ * file init uses to recognise it; a normal boot mounts the system partition,
+ * which has no such file.  Module preinit has nothing to run there (/metadata
+ * is not mounted) and must not take over PID 1's init exec.
+ */
+static bool ksu_preinit_in_recovery(void)
+{
+    struct path p;
+
+    if (kern_path("/system/bin/recovery", LOOKUP_FOLLOW, &p))
+        return false;
+    path_put(&p);
+    return true;
+}
+
 bool ksu_preinit_handle_execve(const char __user **filename_user, const char __user *const __user *argv_user,
                                int orig_nr, struct pt_regs *regs, long *ret)
 {
@@ -120,6 +136,14 @@
     if (strcmp(path, INIT_PATH) || !is_selinux_setup(argv_user))
         return false;
 
+    if (ksu_preinit_in_recovery()) {
+        file = xchg(&ksu_preinit_file, NULL);
+        if (file)
+            fput(file);
+        pr_info("preinit: recovery boot, skipping\n");
+        return false;
+    }
+
     // One shot: the runner's own exec of the real init must pass through.
     file = xchg(&ksu_preinit_file, NULL);
     if (!file)
diff -ruN a/KernelSU/kernel/preinit/runner/runner.c b/KernelSU/kernel/preinit/runner/runner.c
--- a/KernelSU/kernel/preinit/runner/runner.c	2026-11-11 09:13:51.491474800 +0800
